        {
          "path": "user/password",
          "type": "page",
          "layout": "default",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "修改密码"
          },
          "needLogin": true
        },
        {
          "path": "user/rank",
          "type": "page",
          "layout": "default",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "社区达人",
            "enablePullDownRefresh": true,
            "backgroundTextStyle": "dark"
          },
          "needLogin": false
        },
        {
          "path": "user/setting",
          "type": "page",
          "layout": "default",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "编辑资料"
          },
          "needLogin": true
        },
        {
          "path": "webview/webview",
          "type": "page",
          "layout": "default",
          "style": {
            "navigationBarTitleText": "webview"
          }
        }
      ]
    }
  ]
}